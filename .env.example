# Copy to .env and fill in. Keep .env at chmod 600 — it holds secrets.
#
# QUOTE ANY VALUE CONTAINING SPACES. The shell scripts `source` this file, so
# an unquoted value with spaces breaks startup with a confusing error like
# `.env: line 32: agency: command not found`.
# The deploy script rsyncs this file to the target machine.

# --- Telegram credentials -------------------------------------------------
# From https://my.telegram.org -> API development tools. Required by the
# local Bot API server (it speaks MTProto, not the cloud Bot API).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Local Bot API server -------------------------------------------------
# Port the tdlib telegram-bot-api server listens on.
BOT_API_PORT=8081
# Base URL the worker talks to. Point at https://api.telegram.org to bypass
# the local server entirely (then you are back to the 20 MB download limit).
BOT_API_BASE_URL=http://127.0.0.1:8081

# --- Access control -------------------------------------------------------
# Comma-separated chat IDs allowed to use the bot. Empty = allow everyone.
# Send /status from a chat to learn its ID.
ALLOWED_CHAT_IDS=

# --- Transcription --------------------------------------------------------
# ...-turbo-q4 measured ~1.2x faster at 0.998 text similarity on clean speech.
# That was TTS audio though; quantisation usually costs more on noisy or
# accented recordings, so benchmark it on your own voice notes before switching.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# ISO code (en, zh, ms, ta, ...) to force a language; empty = auto-detect.
# Setting this also skips Whisper's language-detection pass on every job.
WHISPER_LANGUAGE=en
# Skip anything longer than this. 0 disables the check.
MAX_AUDIO_SECONDS=7200
# Bias prompt. Whisper mimics the STYLE of this text as well as its
# vocabulary, so write it as a well-punctuated sentence listing the names and
# jargon that recur in your recordings. Measured on a real 2-minute meeting
# slice: sentence breaks went from 1 per 41 words to 1 per 12, at no runtime
# cost. Keep it under ~200 characters — it consumes prompt context.
# e.g. "Project meeting. Acme Corp, Contoso, Q3 roadmap, always-on social."
WHISPER_INITIAL_PROMPT=

# --- Output ---------------------------------------------------------------
# Prefix each line with its [MM:SS] position in the recording.
SHOW_TIMESTAMPS=1
# Seconds between progress-bar edits. Telegram flood-limits edits, so going
# below ~3s risks 429s on long recordings.
PROGRESS_INTERVAL=4

# --- Monitor UI -----------------------------------------------------------
# Browser dashboard: live queue, progress, and archive downloads.
WEB_ENABLED=1
WEB_PORT=8090
# Loopback only. The UI has no authentication and serves transcripts of
# private conversations — do not bind it to 0.0.0.0.
WEB_HOST=127.0.0.1

# --- Summarisation --------------------------------------------------------
# Any OpenAI-compatible server: LM Studio, Ollama, llama.cpp. Loopback by
# default, so transcripts never leave the machine.
LLM_BASE_URL=http://127.0.0.1:1234
# Blank uses whichever model the server currently has loaded.
LLM_MODEL=
# Hour-long meetings are summarised in parts, so allow generous time.
LLM_TIMEOUT=600

# --- Archive --------------------------------------------------------------
# Every job's audio, transcript and metadata are kept here, indexed by
# data/archive/history.jsonl. Defaults to <app>/data/archive.
ARCHIVE_DIR=
# Keep a copy of the original audio alongside each transcript. Set to 0 to
# archive transcripts only.
KEEP_AUDIO=1
# Where scripts/backup-archive.sh copies the archive. Nothing here is backed up
# otherwise, and the archive is the only copy of your recordings. A local path,
# an iCloud/Dropbox folder, or an rsync remote all work.
# e.g. "$HOME/Library/Mobile Documents/com~apple~CloudDocs/telegram-stt"
BACKUP_DEST=

# --- Behaviour ------------------------------------------------------------
# Delete media from the Bot API server's data dir after transcribing. The
# archive keeps its own copy first, so this only removes the server's.
DELETE_MEDIA_AFTER=1
LOG_LEVEL=INFO
