<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.telegram-stt.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP_DIR__/scripts/run-worker.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__APP_DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <!-- Whisper wants the GPU and full clocks; do not let launchd throttle it. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LowPriorityIO</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/worker.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/worker.err.log</string>
</dict>
</plist>
